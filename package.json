{
  "name": "lyyli-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "optimize:check": "node scripts/optimize-images.mjs",
    "optimize:compress": "node scripts/compress-images.mjs",
    "lcp:check": "node scripts/check-lcp.mjs",
    "schema:validate": "node scripts/validate-schema.mjs",
    "schema:test": "npm test -- --testPathPatterns=structured-data",
    "title:verify": "node scripts/verify-titles.mjs",
    "title:test": "npm test -- --testPathPatterns=title",
    "description:check": "node scripts/check-descriptions.mjs",
    "description:test": "npm test -- --testPathPatterns=meta-description",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:404": "playwright test e2e/404",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.4.0",
    "@next/mdx": "^15.5.2",
    "@tailwindcss/postcss": "^4.1.14",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "next": "15.5.2",
    "next-intl": "^4.3.12",
    "react": "^19.2.0",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.0",
    "react-intersection-observer": "^9.16.0",
    "recharts": "^3.1.2",
    "styled-jsx": "^5.1.7",
    "tailwindcss": "^4.0.0-alpha.25",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.5.3",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-testing-library": "^7.13.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "typescript": "^5.9.3"
  }
}
