{
  "name": "lyyli-clone",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "husky",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "optimize:check": "node scripts/optimize-images.mjs",
    "optimize:compress": "node scripts/compress-images.mjs",
    "lcp:check": "node scripts/check-lcp.mjs",
    "schema:validate": "node scripts/validate-schema.mjs",
    "schema:test": "npm test -- --testPathPatterns=structured-data",
    "title:verify": "node scripts/verify-titles.mjs",
    "title:test": "npm test -- --testPathPatterns=title",
    "description:check": "node scripts/check-descriptions.mjs",
    "description:test": "npm test -- --testPathPatterns=meta-description",
    "favicon:verify": "node scripts/verify-favicons.mjs",
    "favicon:test": "npm test -- --testPathPatterns=favicon",
    "sitemap:generate": "node scripts/generate-sitemap.mjs",
    "seo:validate": "node scripts/validate-seo-files.mjs",
    "hreflang:validate": "node scripts/validate-hreflang.mjs",
    "faq:validate": "node scripts/validate-faq-schema.mjs",
    "blog:validate": "node scripts/validate-blog-links.mjs",
    "web-vitals:budget": "node scripts/web-vitals-budget.mjs",
    "web-vitals:test": "npm test -- --testPathPatterns=web-vitals",
    "security:validate": "node scripts/validate-security-headers.mjs",
    "security:test": "npm test -- --testPathPatterns=security",
    "blog:verify": "node scripts/check-blog-separation.mjs",
    "canonical:verify": "node scripts/verify-canonical-host.mjs",
    "canonical:test": "npm test -- --testPathPatterns=canonical-host",
    "cache:test": "node scripts/test-cache-headers.mjs",
    "cache:test:prod": "node scripts/test-cache-headers.mjs https://lyyli.ai",
    "pagination:test": "node scripts/test-pagination.mjs",
    "pagination:test:prod": "node scripts/test-pagination.mjs https://lyyli.ai",
    "links:check": "node scripts/check-broken-links.mjs",
    "links:check:prod": "node scripts/check-broken-links.mjs https://lyyli.ai",
    "links:check:internal": "node scripts/check-broken-links.mjs --internal-only",
    "monitoring:test": "node scripts/test-monitoring.mjs",
    "monitoring:test:prod": "node scripts/test-monitoring.mjs https://lyyli.ai",
    "lighthouse:test": "lighthouse-ci autorun",
    "lighthouse:install": "npm install -g @lhci/cli@0.12.x",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:404": "playwright test e2e/404",
    "e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@next/mdx": "^15.5.2",
    "@tailwindcss/postcss": "^4.1.14",
    "@vercel/analytics": "^1.5.0",
    "chart.js": "^4.5.1",
    "framer-motion": "^12.23.24",
    "gray-matter": "^4.0.3",
    "next": "15.5.2",
    "next-intl": "^4.3.12",
    "next-mdx-remote": "^5.0.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-intersection-observer": "^9.16.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.0.0-alpha.25"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/bundle-analyzer": "^15.5.3",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.20",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "eslint": "^9.37.0",
    "eslint-config-next": "15.5.2",
    "eslint-plugin-testing-library": "^7.13.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.6",
    "mdx": "^0.3.1",
    "prettier": "^3.6.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.3",
    "web-vitals": "^5.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx}": [
      "prettier --write"
    ]
  }
}
