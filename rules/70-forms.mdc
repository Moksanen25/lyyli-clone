### **Rate Limiting**
```typescript
// lib/rateLimit.ts
import { Redis } from '@upstash/redis';

const redis = new Redis({
  url: process.env.UPSTASH_REDIS_URL!,
  token: process.env.UPSTASH_REDIS_TOKEN!,
});

export const rateLimit = {
  async check(identifier: string): Promise<{ allowed: boolean; remaining: number }> {
    const key = `rate_limit:${identifier}`;
    const limit = 5; // 5 submissions per hour
    const window = 3600; // 1 hour
    
    const current = await redis.incr(key);
    
    if (current === 1) {
      await redis.expire(key, window);
    }
    
    const remaining = Math.max(0, limit - current);
    
    return {
      allowed: current <= limit,
      remaining
    };
  }
};
```

## 🔗 HUBSPOT INTEGRATION

### **HubSpot: lähetä lead (source=website), kieli & reitti mukaan** (HubSpot: send lead (source=website), include language & route)

### **HubSpot Lead Submission**
```typescript
// lib/forms/hubspot.ts
interface HubSpotLead {
  email: string;
  firstname?: string;
  lastname?: string;
  company?: string;
  message?: string;
  source: string;
  language: string;
  route: string;
  form_type: string;
}

export async function sendToHubSpot(data: HubSpotLead): Promise<{ id: string }> {
  const portalId = process.env.HUBSPOT_PORTAL_ID;
  const apiKey = process.env.HUBSPOT_API_KEY;
  
  if (!portalId || !apiKey) {
    throw new Error('HubSpot configuration missing');
  }
  
  // Prepare lead data
  const leadData = {
    properties: {
      email: data.email,
      firstname: data.firstname || data.name?.split(' ')[0] || '',
      lastname: data.lastname || data.name?.split(' ').slice(1).join(' ') || '',
      company: data.company || '',
      message: data.message || '',
      source: 'website',
      language: data.language,
      route: data.route,
      form_type: data.form_type || 'contact',
      hs_lead_status: 'NEW',
      createdate: new Date().toISOString()
    }
  };
  
  // Send to HubSpot
  const response = await fetch(
    `https://api.hubapi.com/crm/v3/objects/contacts`,
    {
      method: 'POST',
      headers: {
        'Authorization': `Bearer ${apiKey}`,
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(leadData)
    }
  );
  
  if (!response.ok) {
    const error = await response.text();
    throw new Error(`HubSpot API error: ${error}`);
  }
  
  const result = await response.json();
  return { id: result.id };
}
```

### **HubSpot Form Component**
```tsx
// components/forms/HubSpotForm.tsx
'use client';

import { useConsent } from '@/hooks/useConsent';
import { useLocale } from 'next-intl';

interface HubSpotFormProps {
  portalId: string;
  formId: string;
  title?: string;
  formType: string;
}

export function HubSpotForm({ portalId, formId, title, formType }: HubSpotFormProps) {
  const { consent } = useConsent();
  const locale = useLocale();
  
  useEffect(() => {
    if (consent?.marketing && window.hbspt) {
      window.hbspt.forms.create({
        portalId: portalId,
        formId: formId,
        target: '#hubspot-form',
        region: 'na1',
        onFormReady: (form: any) => {
          // Set hidden fields
          form.setHiddenFields({
            source: 'website',
            language: locale,
            route: window.location.pathname,
            form_type: formType
          });
          
          // Add GDPR consent field
          const consentField = form.findField('gdpr_consent');
          if (consentField) {
            consentField.setValue(true);
          }
        },
        onFormSubmitted: (form: any) => {
          // Track form submission
          trackFormSubmit(formType, locale, window.location.pathname);
          
          // Redirect to thank you page
          window.location.href = `/${locale}/thank-you?form=${formType}`;
        }
      });
    }
  }, [consent, portalId, formId, locale, formType]);
  
  if (!consent?.marketing) {
    return (
      <div className="text-center p-8 bg-gray-50 rounded-lg">
        <p className="text-darkGray mb-4">
          Marketing consent required to show this form
        </p>
      </div>
    );
  }
  
  return (
    <div className="hubspot-form-container">
      {title && (
        <h3 className="font-playfair text-2xl text-forest mb-6">
          {title}
        </h3>
      )}
      
      <div id="hubspot-form" className="min-h-[400px]" />
    </div>
  );
}
```

