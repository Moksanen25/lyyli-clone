### **Form Submit Analytics**
```typescript
// lib/analytics/formTracking.ts
export async function trackFormSubmit(formType: string, language: string, route: string) {
  const eventData = {
    event_type: 'form_submit',
    form_type: formType,
    language,
    route,
    timestamp: new Date().toISOString(),
    success: true
  };
  
  // Track in analytics systems
  if (window.gtag) {
    window.gtag('event', 'form_submit', {
      form_type: formType,
      language,
      route
    });
  }
  
  if (window.hj) {
    window.hj('event', 'form_submit', eventData);
  }
  
  // Send to your analytics API
  try {
    await fetch('/api/analytics/form-submit', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(eventData)
    });
  } catch (error) {
    console.error('Failed to track form submission:', error);
  }
}
```

