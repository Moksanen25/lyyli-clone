### **Environment Validation**
```typescript
// lib/env.ts
export function validateEnvironment() {
  const required = [
    'NEXT_PUBLIC_GA_ID',
    'NEXT_PUBLIC_HOTJAR_ID',
    'NEXT_PUBLIC_HUBSPOT_PORTAL_ID',
    'NEXT_PUBLIC_DATAFAST_KEY'
  ];

  const missing = required.filter(key => !process.env[key]);
  
  if (missing.length > 0) {
    throw new Error(`Missing required environment variables: ${missing.join(', ')}`);
  }
}
```

## 📈 EVENT TRACKING

### **Lähetä page_view & CTA-click eventit (kentät: language, route, cta_variant)** (Send page_view & CTA-click events with fields: language, route, cta_variant)

### **Event Tracking Implementation**
```typescript
// lib/analytics.ts
import { useConsent } from '@/hooks/useConsent';

interface EventData {
  language: string;
  route: string;
  cta_variant?: string;
  [key: string]: any;
}

export function trackEvent(eventName: string, data: EventData) {
  const { consent } = useConsent();
  
  // Only track if analytics consent is given
  if (!consent?.analytics) return;

  // Google Analytics 4
  if (window.gtag) {
    window.gtag('event', eventName, {
      ...data,
      event_category: 'engagement',
      event_label: data.route
    });
  }

  // Hotjar
  if (window.hj) {
    window.hj('event', eventName, data);
  }

  // Datafast
  if (window.datafast) {
    window.datafast.push({
      event: eventName,
      data: data
    });
  }
}

// Page view tracking
export function trackPageView(route: string, language: string) {
  trackEvent('page_view', {
    language,
    route,
    timestamp: new Date().toISOString()
  });
}

// CTA click tracking
export function trackCTAClick(route: string, language: string, ctaVariant: string) {
  trackEvent('cta_click', {
    language,
    route,
    cta_variant: ctaVariant,
    timestamp: new Date().toISOString()
  });
}
```

### **Page View Tracking Hook**
```typescript
// hooks/usePageTracking.ts
'use client';

import { useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { useLocale } from 'next-intl';
import { trackPageView } from '@/lib/analytics';

export function usePageTracking() {
  const router = useRouter();
  const locale = useLocale();

  useEffect(() => {
    const handleRouteChange = (url: string) => {
      trackPageView(url, locale);
    };

    // Track initial page view
    trackPageView(window.location.pathname, locale);

    // Listen for route changes
    router.events?.on('routeChangeComplete', handleRouteChange);

    return () => {
      router.events?.off('routeChangeComplete', handleRouteChange);
    };
  }, [router, locale]);
}
```

### **CTA Click Tracking**
```tsx
// components/CTAButton.tsx
'use client';

import { useLocale } from 'next-intl';
import { useRouter } from 'next/navigation';
import { trackCTAClick } from '@/lib/analytics';

interface CTAButtonProps {
  variant: string;
  href: string;
  children: React.ReactNode;
  className?: string;
}

export function CTAButton({ variant, href, children, className }: CTAButtonProps) {
  const locale = useLocale();
  const router = useRouter();

  const handleClick = () => {
    // Track CTA click
    trackCTAClick(window.location.pathname, locale, variant);
    
    // Navigate to destination
    router.push(href);
  };

  return (
    <button
      onClick={handleClick}
      className={`px-6 py-3 bg-forest text-white rounded-lg hover:bg-forest/90 transition-colors ${className}`}
    >
      {children}
    </button>
  );
}
```

## 📝 HUBSPOT FORMS & GDPR COMPLIANCE

### **HubSpot-lomakkeet: GDPR-suostumus & tietosuojalinkit mukaan** (HubSpot forms: GDPR consent & privacy policy links included)

### **HubSpot Form Configuration**
```tsx
// components/HubSpotForm.tsx
'use client';

import { useConsent } from '@/hooks/useConsent';

interface HubSpotFormProps {
  portalId: string;
  formId: string;
  title?: string;
}

export function HubSpotForm({ portalId, formId, title }: HubSpotFormProps) {
  const { consent } = useConsent();

  useEffect(() => {
    if (consent?.marketing && window.hbspt) {
      window.hbspt.forms.create({
        portalId: portalId,
        formId: formId,
        target: '#hubspot-form',
        region: 'na1',
        onFormReady: (form: any) => {
          // Add GDPR consent field
          const consentField = form.findField('gdpr_consent');
          if (consentField) {
            consentField.setValue(true);
          }
        }
      });
    }
  }, [consent, portalId, formId]);

  if (!consent?.marketing) {
    return (
      <div className="text-center p-8 bg-gray-50 rounded-lg">
        <p className="text-darkGray mb-4">
          Marketing analytics consent required to show this form
        </p>
        <button
          onClick={() => updateConsent({ ...consent, marketing: true })}
          className="px-4 py-2 bg-forest text-white rounded hover:bg-forest/90"
        >
          Enable Marketing Analytics
        </button>
      </div>
    );
  }

  return (
    <div className="hubspot-form-container">
      {title && (
        <h3 className="font-playfair text-2xl text-forest mb-6">
          {title}
        </h3>
      )}
      
      <div id="hubspot-form" className="min-h-[400px]" />
      
      <div className="mt-4 text-xs text-mediumGray">
        <p>
          By submitting this form, you agree to our{' '}
          <a href="/privacy" className="underline hover:text-forest">
            Privacy Policy
          </a>
          {' '}and{' '}
          <a href="/terms" className="underline hover:text-forest">
            Terms of Service
          </a>
          .
        </p>
        <p className="mt-2">
          You can withdraw your consent at any time by contacting us.
        </p>
      </div>
    </div>
  );
}
```

