## 🍪 CONSENT BANNER IMPLEMENTATION

### **Toteuta consent-banneri; lataa skriptit vasta consentin jälkeen** (Implement consent banner; load scripts only after consent)

### **Consent Banner Component**
```tsx
// components/ConsentBanner.tsx
'use client';

import { useState, useEffect } from 'react';
import { useConsent } from '@/hooks/useConsent';

export function ConsentBanner() {
  const { consent, updateConsent, hasConsented } = useConsent();
  const [isVisible, setIsVisible] = useState(false);

  useEffect(() => {
    // Show banner if no consent decision has been made
    if (!hasConsented) {
      setIsVisible(true);
    }
  }, [hasConsented]);

  const handleAccept = () => {
    updateConsent({
      analytics: true,
      marketing: true,
      necessary: true
    });
    setIsVisible(false);
  };

  const handleReject = () => {
    updateConsent({
      analytics: false,
      marketing: false,
      necessary: true
    });
    setIsVisible(false);
  };

  if (!isVisible) return null;

  return (
    <div className="fixed bottom-0 left-0 right-0 bg-white border-t border-gray-200 p-4 z-50">
      <div className="max-w-4xl mx-auto">
        <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div className="flex-1">
            <h3 className="font-playfair text-lg text-forest mb-2">
              Evästeiden käyttö
            </h3>
            <p className="text-sm text-darkGray">
              Käytämme evästeitä parantaaksemme sivuston toimintaa ja tarjotaksemme 
              sinulle paremman käyttökokemuksen. Hyväksymällä evästeet suostut 
              niiden käyttöön.
            </p>
            <div className="mt-2 text-xs text-mediumGray">
              <a href="/privacy" className="underline hover:text-forest">
                Tietosuojakäytäntö
              </a>
              {' • '}
              <a href="/cookies" className="underline hover:text-forest">
                Evästeet
              </a>
            </div>
          </div>
          <div className="flex gap-3">
            <button
              onClick={handleReject}
              className="px-4 py-2 text-sm border border-forest text-forest rounded hover:bg-forest hover:text-white transition-colors"
            >
              Hylkää
            </button>
            <button
              onClick={handleAccept}
              className="px-4 py-2 text-sm bg-forest text-white rounded hover:bg-forest/90 transition-colors"
            >
              Hyväksy kaikki
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}
```

### **Consent Hook**
```typescript
// hooks/useConsent.ts
'use client';

import { useState, useEffect } from 'react';

interface ConsentPreferences {
  necessary: boolean;
  analytics: boolean;
  marketing: boolean;
}

export function useConsent() {
  const [consent, setConsent] = useState<ConsentPreferences | null>(null);
  const [hasConsented, setHasConsented] = useState(false);

  useEffect(() => {
    // Load consent from localStorage
    const savedConsent = localStorage.getItem('lyyli-consent');
    if (savedConsent) {
      const parsedConsent = JSON.parse(savedConsent);
      setConsent(parsedConsent);
      setHasConsented(true);
    }
  }, []);

  const updateConsent = (newConsent: ConsentPreferences) => {
    setConsent(newConsent);
    setHasConsented(true);
    localStorage.setItem('lyyli-consent', JSON.stringify(newConsent));
    
    // Trigger consent update event
    window.dispatchEvent(new CustomEvent('consent-updated', { detail: newConsent }));
  };

  return { consent, updateConsent, hasConsented };
}
```

## 📊 ANALYTICS SCRIPT LOADING

### **GA4, Hotjar, HubSpot, Datafast lisätään <Script> strategy="afterInteractive"** (GA4, Hotjar, HubSpot, Datafast added with <Script> strategy="afterInteractive")

### **Conditional Script Loading**
```tsx
// components/AnalyticsScripts.tsx
'use client';

import Script from 'next/script';
import { useConsent } from '@/hooks/useConsent';

export function AnalyticsScripts() {
  const { consent, hasConsented } = useConsent();

  // Don't load scripts until consent is given
  if (!hasConsented || !consent?.analytics) {
    return null;
  }

  return (
    <>
      {/* Google Analytics 4 */}
      <Script
        src={`https://www.googletagmanager.com/gtag/js?id=${process.env.NEXT_PUBLIC_GA_ID}`}
        strategy="afterInteractive"
      />
      <Script id="ga4" strategy="afterInteractive">
        {`
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', '${process.env.NEXT_PUBLIC_GA_ID}', {
            page_title: document.title,
            page_location: window.location.href,
            language: document.documentElement.lang || 'en'
          });
        `}
      </Script>

      {/* Hotjar */}
      <Script id="hotjar" strategy="afterInteractive">
        {`
          (function(h,o,t,j,a,r){
            h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
            h._hjSettings={hjid:${process.env.NEXT_PUBLIC_HOTJAR_ID},hjsv:6};
            a=o.getElementsByTagName('head')[0];
            r=o.createElement('script');r.async=1;
            r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
            a.appendChild(r);
          })(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
        `}
      </Script>

      {/* HubSpot */}
      <Script
        src={`//js.hs-scripts.com/${process.env.NEXT_PUBLIC_HUBSPOT_PORTAL_ID}.js`}
        strategy="afterInteractive"
      />

      {/* Datafast */}
      <Script id="datafast" strategy="afterInteractive">
        {`
          window.datafast = window.datafast || [];
          window.datafast.push({
            key: '${process.env.NEXT_PUBLIC_DATAFAST_KEY}',
            config: {
              consent: true
            }
          });
        `}
      </Script>
    </>
  );
}
```

