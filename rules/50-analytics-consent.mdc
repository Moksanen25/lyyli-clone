### **Cookie Management**
```typescript
// lib/cookies.ts
export function getCookieConsent() {
  if (typeof window === 'undefined') return null;
  
  const consent = localStorage.getItem('lyyli-consent');
  return consent ? JSON.parse(consent) : null;
}

export function setCookieConsent(consent: ConsentPreferences) {
  if (typeof window === 'undefined') return;
  
  localStorage.setItem('lyyli-consent', JSON.stringify(consent));
  
  // Set cookie consent flag
  document.cookie = `lyyli-consent=${JSON.stringify(consent)}; path=/; max-age=31536000; SameSite=Strict`;
}
```

